---
import { site } from '../site';
---
<section class="hero">
  <div class="signal" aria-hidden="true">
    <svg id="net" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="fade" cx="76%" cy="34%" r="62%">
          <stop offset="0%" stop-color="#4da3ff" stop-opacity="0.22" />
          <stop offset="55%" stop-color="#4da3ff" stop-opacity="0.05" />
          <stop offset="100%" stop-color="#4da3ff" stop-opacity="0" />
        </radialGradient>
        <!-- invisible edge paths for packets to travel -->
        <path id="e1" d="M150 140 L360 240" />
        <path id="e2" d="M360 240 L250 430" />
        <path id="e3" d="M360 240 L560 180" />
        <path id="e4" d="M560 180 L700 360" />
        <path id="e5" d="M250 430 L700 360" />
        <path id="e6" d="M560 180 L900 220" />
        <path id="e7" d="M700 360 L900 220" />
        <path id="e8" d="M900 220 L1050 120" />
      </defs>

      <rect width="1200" height="600" fill="url(#fade)" />

      <!-- emanating signal rings from the hub -->
      <g fill="none" stroke="#4da3ff" stroke-opacity="0.22">
        <circle class="ring" cx="900" cy="220" r="60" />
        <circle class="ring" cx="900" cy="220" r="60" style="animation-delay:1.4s" />
        <circle class="ring" cx="900" cy="220" r="60" style="animation-delay:2.8s" />
        <circle class="ring" cx="900" cy="220" r="60" style="animation-delay:4.2s" />
      </g>
      <!-- rotating dashed orbit around the hub -->
      <circle class="orbit" cx="900" cy="220" r="46" fill="none" stroke="#4da3ff" stroke-opacity="0.5"
        stroke-width="1" stroke-dasharray="3 9" />

      <!-- edges -->
      <g stroke="#ffffff" stroke-opacity="0.08" stroke-width="1">
        <line x1="150" y1="140" x2="360" y2="240" /><line x1="360" y1="240" x2="250" y2="430" />
        <line x1="360" y1="240" x2="560" y2="180" /><line x1="560" y1="180" x2="700" y2="360" />
        <line x1="250" y1="430" x2="700" y2="360" /><line x1="560" y1="180" x2="900" y2="220" />
        <line x1="700" y1="360" x2="900" y2="220" /><line x1="900" y1="220" x2="1050" y2="120" />
      </g>

      <!-- nodes (twinkle) -->
      <g fill="#cfe0f2">
        <circle class="node" cx="150" cy="140" r="3.5" />
        <circle class="node" cx="360" cy="240" r="3.5" style="animation-delay:.6s" />
        <circle class="node" cx="250" cy="430" r="3.5" style="animation-delay:1.2s" />
        <circle class="node" cx="560" cy="180" r="3.5" style="animation-delay:.3s" />
        <circle class="node" cx="700" cy="360" r="3.5" style="animation-delay:.9s" />
        <circle class="node" cx="1050" cy="120" r="3.5" style="animation-delay:1.5s" />
      </g>
      <!-- hub node -->
      <circle cx="900" cy="220" r="6" fill="#4da3ff" />

      <!-- data packets travelling the edges -->
      <g fill="#6fb5ff">
        <circle r="3.2"><animateMotion dur="2.6s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#e1"/></animateMotion></circle>
        <circle r="3.2"><animateMotion dur="2.9s" begin="0.4s" repeatCount="indefinite"><mpath href="#e3"/></animateMotion></circle>
        <circle r="3.2"><animateMotion dur="3.4s" begin="0.9s" repeatCount="indefinite"><mpath href="#e6"/></animateMotion></circle>
        <circle r="3.2"><animateMotion dur="2.2s" begin="0.2s" repeatCount="indefinite"><mpath href="#e4"/></animateMotion></circle>
        <circle r="3.2"><animateMotion dur="3.0s" begin="1.1s" repeatCount="indefinite"><mpath href="#e5"/></animateMotion></circle>
        <circle r="3.6" fill="#9ecbff"><animateMotion dur="1.6s" begin="0.6s" repeatCount="indefinite"><mpath href="#e8"/></animateMotion></circle>
      </g>
    </svg>
  </div>

  <div class="container hero-inner">
    <p class="eyebrow reveal">{site.role} · {site.location}</p>
    <h1 class="headline">
      <span class="line"><span class="w">Networks</span> <span class="w">that</span></span>
      <span class="line"><span class="w hl">ship</span> <span class="w hl">on</span> <span class="w hl">schedule.</span></span>
    </h1>
    <p class="lede reveal">I lead wireless buildout and modernization programs for carriers, OEMs and tower companies — turning aggressive 4G/5G roadmaps into delivered sites, disciplined budgets and teams that perform under pressure.</p>
    <div class="cta reveal">
      <a href="/contact/" class="btn btn-primary">Start a conversation <span class="arrow">→</span></a>
      <a href="/impact/" class="btn">See the impact</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .signal { position: absolute; inset: 0; z-index: 0; pointer-events: none; animation: drift 22s ease-in-out infinite alternate; }
  .signal svg { width: 100%; height: 100%; display: block; }
  .hero-inner { position: relative; z-index: 1; padding-block: clamp(88px, 15vw, 168px); }
  .hero h1 { margin: 6px 0 26px; }
  .hero .lede { margin-bottom: 34px; }
  .cta { display: flex; gap: 14px; flex-wrap: wrap; }

  /* headline: word-by-word rise + accent underline sweep */
  .headline { display: block; }
  .headline .line { display: block; overflow: hidden; }
  .headline .w {
    display: inline-block;
    opacity: 0; transform: translateY(105%);
    animation: rise .8s cubic-bezier(.2,.7,.2,1) forwards;
  }
  .headline .line:nth-child(1) .w:nth-child(1) { animation-delay: .05s; }
  .headline .line:nth-child(1) .w:nth-child(2) { animation-delay: .13s; }
  .headline .line:nth-child(2) .w:nth-child(1) { animation-delay: .24s; }
  .headline .line:nth-child(2) .w:nth-child(2) { animation-delay: .32s; }
  .headline .line:nth-child(2) .w:nth-child(3) { animation-delay: .40s; }
  .hl { color: var(--accent); position: relative; }
  .headline .line:nth-child(2) { position: relative; }
  .headline .line:nth-child(2)::after {
    content: ''; position: absolute; left: 2px; bottom: 6px; height: 2px; width: 0;
    background: var(--accent); opacity: .55;
    animation: sweep .7s ease .7s forwards;
  }

  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes sweep { to { width: min(6.2em, 100%); } }
  @keyframes drift { from { transform: translate3d(0,0,0); } to { transform: translate3d(-14px,10px,0); } }

  /* svg motion */
  .ring { transform-box: fill-box; transform-origin: center; animation: emanate 5.6s ease-out infinite; opacity: 0; }
  @keyframes emanate { 0% { r:40px; opacity:0; } 18% { opacity:.5; } 100% { r:180px; opacity:0; } }
  .orbit { transform-box: fill-box; transform-origin: center; animation: spin 14s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .node { animation: twinkle 3.4s ease-in-out infinite; }
  @keyframes twinkle { 0%,100% { opacity: .35; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .signal { animation: none; }
    .headline .w { opacity: 1; transform: none; animation: none; }
    .headline .line:nth-child(2)::after { width: min(6.2em,100%); animation: none; }
    .ring, .orbit, .node { animation: none; }
    .ring { opacity: .18; }
  }
</style>

<script>
  // Pause SMIL packet animation when the user prefers reduced motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const svg = document.getElementById('net');
    // @ts-ignore - pauseAnimations is part of SVGSVGElement
    svg && svg.pauseAnimations && svg.pauseAnimations();
  }
</script>
