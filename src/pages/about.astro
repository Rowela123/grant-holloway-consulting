---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const facts = [
  { k: 'Focus', v: 'Wireless buildout · 4G/5G modernization · delivery turnaround' },
  { k: 'Works with', v: 'Carriers, OEMs, tower & infrastructure companies' },
  { k: 'Based in', v: `${site.location} · works US-wide` },
  { k: 'Engagements', v: 'Fractional leadership & advisory, a few clients at a time' },
];
const principles = [
  { t: 'Clarity before speed', d: 'Everyone knows the goal, the plan and where they stand. Ambiguity is the real schedule risk, so I kill it early.' },
  { t: 'Evidence over noise', d: 'Scorecards, aging and real numbers drive the conversation — not the loudest voice in the room.' },
  { t: 'Build the team, not the dependency', d: 'The aim is a team that performs after I leave: capability, habits and accountability that stay.' },
];
---
<Base title="About" description={`About ${site.name} — wireless network delivery leader turned independent consultant.`}>
  <section class="pad-sm container">
    <div class="profile reveal">
      <img class="photo" src="/images/headshot.jpg" alt={`Portrait of ${site.name}`} width="200" height="250" />
      <div>
        <p class="eyebrow">About</p>
        <h1 class="name">{site.name}</h1>
        <p class="lede">Wireless network delivery leader with 15+ years driving buildouts, modernization and the teams that make them happen — now working independently with a small set of clients.</p>
      </div>
    </div>
  </section>

  <section class="container bio">
    <div class="bio-body">
      <p>I spent my career in wireless infrastructure — most recently leading regional 4G/5G deployment across the Carolinas and Tennessee, owning a portfolio of 1,250 sites and a $15–20M capital budget with a team of 13 engineers. I left day-to-day operations to do the part I care about most: helping a handful of organizations get their delivery under control, properly, rather than spreading thin across dozens.</p>
      <p>My work sits where strategy meets execution. I help carriers, OEMs and tower companies align regional buildout with corporate modernization priorities, tighten vendor performance, and install the operating rhythm that turns a roadmap into delivered sites. I'm a steady partner to senior leadership — direct about risk, honest about trade-offs, and focused on getting initiatives moving through clarity and accountability rather than pressure.</p>
      <p>What I'm known for: transparent communication, mentoring teams to their potential, and disciplined execution against aggressive timelines. Networks are built by people, and people deliver when the goal is clear and the plan is real.</p>

      <h2 class="lead-h">How I lead</h2>
      {principles.map((p) => (
        <div class="principle reveal">
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pad-sm container">
    <div class="facts">
      {facts.map((f) => (
        <div class="fact reveal">
          <p class="fk mono">{f.k}</p>
          <p class="fv">{f.v}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .profile { display: flex; gap: 36px; align-items: center; }
  .photo { width: 200px; flex: none; border: 1px solid var(--line); border-radius: 3px; object-fit: cover; filter: grayscale(0.2) contrast(1.02); }
  .name { margin: 4px 0 20px; }

  .bio { max-width: 760px; margin-inline: auto; padding-bottom: 8px; }
  .bio-body p { font-size: 1.06rem; }
  .lead-h { margin: 48px 0 8px; }
  .principle { border-top: 1px solid var(--line); padding: 22px 0; }
  .principle h3 { margin-bottom: 6px; }
  .principle p { margin: 0; }

  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .fact { background: var(--bg); padding: 26px; }
  .fk { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin: 0 0 10px; }
  .fv { margin: 0; color: var(--ink); }

  @media (max-width: 620px) {
    .profile { flex-direction: column; align-items: flex-start; gap: 22px; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
