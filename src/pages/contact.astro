---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const details = [
  { k: 'Elsewhere', v: 'LinkedIn', href: site.linkedin },
  { k: 'Phone', v: site.phone, href: `tel:${site.phone.replace(/[^+\d]/g, '')}` },
  { k: 'Location', v: `${site.location} · US-wide & remote` },
  { k: 'Availability', v: 'Taking new engagements from Q4 2026' },
];
---
<Base title="Contact" description={`Contact ${site.name} — wireless network delivery consulting.`}>
  <section class="pad-sm container head reveal">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk delivery.</h1>
    <p class="lede">Whether it's a stalled buildout, a modernization push or a team that needs steadying, the best start is a short email — a couple of lines on where things stand and what's in the way.</p>
  </section>

  <section class="container email-block reveal">
    <p class="ek mono">Email</p>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="muted note">I read everything and reply personally, usually within two working days.</p>
  </section>

  <section class="container">
    <div class="details">
      {details.map((d) => (
        <div class="detail reveal">
          <p class="dk mono">{d.k}</p>
          {d.href
            ? <a class="dv" href={d.href}>{d.v}</a>
            : <p class="dv">{d.v}</p>}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .head h1 { margin-bottom: 20px; }
  .email-block { padding-block: 8px 40px; }
  .ek { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; }
  .email { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 4vw, 2.4rem); letter-spacing: -0.02em; color: var(--ink); }
  .email:hover { color: var(--accent); }
  .note { margin: 18px 0 0; }

  .details { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .detail { background: var(--bg); padding: 26px; }
  .dk { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); margin: 0 0 10px; }
  .dv { margin: 0; color: var(--ink); display: inline-block; }

  @media (max-width: 620px) { .details { grid-template-columns: 1fr; } }
</style>
